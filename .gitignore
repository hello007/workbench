# build/ 构建产物整体忽略；README-linux.md 为手写的 Linux 发行包说明源文件
# （release.yml 打包 tar.gz 时随二进制分发），白名单放行提交
build/*
!build/README-linux.md
data/*.json
frontend/dist/
frontend/package.json.md5
frontend/wailsjs/
go.work
node_modules
# 仅忽略根目录的 release 构建产物，避免误伤 .claude/skills/release/ 等同名目录
/release/
Thumbs.db
vendor/
agent-harness/
bash.exe.stackdump
notify_error.log
# 结构化日志落盘目录（slog + lumberjack，见 docs/spec/logging-and-errors.md）
data/logs/
data/ai_task*
# AI 对话运行时存储（ChatService 会话索引与消息落盘，见 docs/spec/ai-chat-service.md）
data/ai_chat/
# serve 模式访问令牌（运行期生成的机密文件，见 server/token.go）
data/web_token
# 多 token 记录落盘（SHA-256 哈希名册，运行期生成，见 service/web_token.go）
data/web_tokens.json
# 认证审计 JSONL（运行期追加，见 service/web_audit.go）
data/web_audit.log
# 异常退出标记（startup 检测上次会话崩溃/强杀，正常 shutdown 删除，见 app.go）
data/crash.flag

# 素材管理运行时数据（每库 SQLite 索引 db + 缩略图缓存目录，见 docs/spec/assets-management.md 存储布局）
data/assets/
data/pptx_preview_pdf/

.claude/settings.local.json
# Coverage report artifacts
frontend/coverage/
coverage.out

# Playwright E2E artifacts
frontend/test-results/
frontend/playwright-report/

# cc-connect 桥接会话产物（附件缓存，环境运行时目录）
.cc-connect/
